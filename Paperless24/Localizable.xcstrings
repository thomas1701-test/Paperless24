    "Der Lesemodus zeigt den erkannten Text auf warmem Papierton mit größerer Schrift." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading mode shows the recognized text on a warm paper tone in larger type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo lectura muestra el texto reconocido sobre un tono papel cálido y con letra más grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode lecture affiche le texte reconnu sur un ton papier chaud, en plus grand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità lettura mostra il testo riconosciuto su un tono carta caldo e con caratteri più grandi."
          }
        }
      }
    },
    "Der Link konnte nicht erstellt werden." : {
