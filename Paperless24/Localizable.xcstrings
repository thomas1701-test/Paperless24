    "Finde ${query} im Archiv, höchstens ${limit} Treffer" : {

    },
    "Findet AirScan-/eSCL-fähige Scanner im lokalen Netzwerk. Funktioniert nicht mit jedem Modell." : {

    },
    "Findet Zahlungsziele, Kündigungs- und Garantiefristen im Text — nur wenn ein eindeutiges Schlüsselwort daneben steht. Gespeichert wird erst, was du bestätigst; die Frist landet in einem Datumsfeld auf dem Server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds payment, cancellation and warranty deadlines in the text — only next to a clear keyword. Nothing is saved until you confirm; the deadline goes into a date field on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra plazos de pago, cancelación y garantía en el texto, solo junto a una palabra clave clara. Nada se guarda hasta que lo confirmes; el plazo va a un campo de fecha en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repère les échéances de paiement, de résiliation et de garantie dans le texte — uniquement à côté d'un mot-clé explicite. Rien n'est enregistré sans ta confirmation ; l'échéance va dans un champ date sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova scadenze di pagamento, disdetta e garanzia nel testo, solo accanto a una parola chiave chiara. Nulla viene salvato finché non confermi; la scadenza finisce in un campo data sul server."
          }
        }
      }
    },
    "Foto" : {

    },
    "Frag dein Archiv …" : {

    },
    "Fragt beim Öffnen und nach einer Minute im Hintergrund nach Face ID oder dem Gerätecode." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks for Face ID or the device passcode when opening and after a minute in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide Face ID o el código del dispositivo al abrir y tras un minuto en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
