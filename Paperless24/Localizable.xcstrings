    "Alle Konten werden samt Offline-Dateien und Zugangsdaten vom Gerät entfernt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All accounts, offline files and credentials will be removed from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las cuentas, los archivos sin conexión y las credenciales se eliminarán del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les comptes, fichiers hors ligne et identifiants seront supprimés de l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli account, i file offline e le credenziali verranno rimossi dal dispositivo."
          }
        }
      }
    },
    "Alle Konten werden samt Offline-Dateien und Zugangsdaten vom Gerät entfernt. Noch nicht übertragene Uploads und Änderungen gehen verloren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All accounts, offline files and credentials will be removed from this device. Uploads and changes not yet sent will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las cuentas, los archivos sin conexión y las credenciales se eliminarán del dispositivo. Las subidas y cambios aún no enviados se perderán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les comptes, fichiers hors ligne et identifiants seront supprimés de l'appareil. Les envois et modifications non transmis seront perdus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli account, i file offline e le credenziali verranno rimossi dal dispositivo. I caricamenti e le modifiche non ancora inviati andranno persi."
          }
        }
      }
    },
