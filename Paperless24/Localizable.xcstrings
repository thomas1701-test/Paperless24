    "Die Adresse begann mit http://. Verbunden wird trotzdem verschlüsselt — für einen Server ohne HTTPS den Schalter einschalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address started with http://. The connection is still encrypted — turn on the switch for a server without HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección empezaba por http://. La conexión sigue cifrada; activa el interruptor para un servidor sin HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse commençait par http://. La connexion reste chiffrée — active l'interrupteur pour un serveur sans HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indirizzo iniziava con http://. La connessione resta cifrata: attiva l'interruttore per un server senza HTTPS."
          }
        }
      }
