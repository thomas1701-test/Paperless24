<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.Thomas.paperless.refresh</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Paperless24 sucht im lokalen Netzwerk nach AirScan-fähigen Dokumentenscannern, um direkt scannen zu können.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Paperless24 legt auf deinen Wunsch Erinnerungen für erkannte Fristen (z. B. Zahlungsziele, Kündigungsfristen) an.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_uscan._tcp</string>
		<string>_uscans._tcp</string>
		<string>_scanner._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.paperless24.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>paperless24</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		NSAllowsArbitraryLoads ist notwendig, weil Paperless24 ein Client für
		selbst gehostete Paperless-ngx-Server ist. Nutzer betreiben ihre Server
		auf eigener Infrastruktur mit selbst gewählten URLs (HTTP oder HTTPS).
		Da die Server-URL vollständig vom Nutzer konfiguriert wird und sowohl
		HTTP- als auch HTTPS-Verbindungen unterstützt werden müssen, ist eine
		Vorab-Einschränkung auf bestimmte Domains nicht möglich.
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
